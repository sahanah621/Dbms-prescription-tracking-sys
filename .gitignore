# ==============================================================================
# Git Ignore Configuration - Prescription Tracking System
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secret Files (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
# Ignore all local environment and secret configuration files
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.local

# Explicitly allow template files to be tracked in version control
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# Backend - Python Virtual Environments
# ------------------------------------------------------------------------------
backend/.venv/
backend/venv/
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Backend - Python Cache & Bytecode Artifacts
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Python test, coverage, and linting artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Python packaging & build artifacts
build/
dist/
*.egg-info/
.eggs/

# ------------------------------------------------------------------------------
# Frontend - Dependencies & Build Outputs
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/

# ------------------------------------------------------------------------------
# Logs
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# IDE, Editor & OS Temporary Files
# ------------------------------------------------------------------------------
# OS-generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors & IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.tmp
*.bak
